-- Vytvoř pohled, který bude ukazovat vývoj Tržeb našeho obchodního řetězce po letech a městech. 
select view v_vyvojtrzeb as
select a.mesto, strftime('%Y', u.datumnakupu) as rok, sum(u.castka) as celkovetrzby from uctenka u 
left join prodejna p on u.idprodejna = p.idprodejna 
left join adresa a on a.idadresa = p.IDAdresa
group by a.mesto, rok;
