-- Určete zaměstnance s nejvyšší tržbou prodejů.
select z.idzamestnanec, z.jmeno, z.prijmeni, sum(u.castka) as trzba from uctenka u join zamestnanec z on z.idzamestnanec = u.idzamestnanec 
group by z.idzamestnanec, z.jmeno, z.prijmeni order by trzba desc;
-- Určete zaměstnance s nejvyšší tržbou, zjistěte kolik let pracuje nebo pracoval, výsledky seřaďte podle celkové Tržby 
select  z.idzamestnanec, z.jmeno, z.prijmeni, (coalesce(z.datumodchodu, date()) - z.datumnastupu) dobazamestnani, sum(u.castka) as trzba
from zamestnanec z join uctenka u on u.idzamestnanec = z.idzamestnanec group by z.idzamestnanec, z.jmeno, z.prijmeni, dobazamestnani order by trzba desc;
-- BONUSY
-- Jaké prodejny zásobuje sklad v Buštěhradu (ID 5).
select s.nazev, p.nazev from skladprodejna sp join prodejna p on sp.idprodejna = p.idprodejna
join sklad s on s.idsklad = sp.idsklad and s.idsklad = 5;
-- Jaké sklady zásobují prodejnu Slaný 1 (ID 135).
select p.nazev as prodejna, s.nazev as sklad, s.typ from prodejna p 
join skladprodejna sp on sp.idprodejna = p.IDProdejna join sklad s on s.idsklad = sp.IDSklad where p.idprodejna = 135;
