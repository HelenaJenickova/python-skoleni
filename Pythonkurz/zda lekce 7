/* Left join */
-- Kolik zákazníků máme v každém z měst? Zobraz i města, kde není registrovaný žádný zákazník. Zobraz jen města, které mají maximálně 5 zákazníků
select a.mesto, count(distinct idzakaznik) as pocet from zakaznik z left join adresa a on z.idadresa = a.idadresa group by a.mesto having pocet < 6;
-- Zjistěte jaký je podíl prodejů registrovaných zákazníků na jednotlivých prodejnách. Zahrňte i prodejny kde nebyl žádný prodej.
select p.nazev, count(iductenka) as prodejucelkem, count(idzakaznik) as prodejusezakaznikem, 
round(cast(count(idzakaznik) as float)/cast(count(iductenka) as float),2) podilregistrovanychprodeju
from prodejna p left join uctenka u on u.idprodejna = p.idprodejna group by p.nazev order by prodejucelkem;

/* Samostatná práce */
-- Kolik zaměstnanců mají jednotlivé prodejny. Vypište i prodejny, které nemají žádné zaměstnance
select p.idprodejna, p.nazev, count(z.idzamestnanec) as pocetzamestnancu, sum(z.uvazek) uvazek
from prodejna p left join zamestnanec z on p.idprodejna = z.idprodejna 
and z.datumodchodu is null
group by p.idprodejna, p.nazev order by pocetzamestnancu;

-- Pro novou reklamní kampaň potřebujeme zjistit Zákazníky, které máme zaregistrované a ještě nenakoupili.
select z.idzakaznik, z.jmeno, z.prijmeni, u.iductenka from zakaznik z left join uctenka u on u.idzakaznik = z.idzakaznik
where u.iductenka is null;

-- Zjistěte, kde (v jakých městech) máme takových zákazníků nejvíce a proto by se do nich měla soustředit naše reklamní kampaň.
select  a.mesto, count(z.idzakaznik) as pocetzakaznikubeznakupu from zakaznik z left join uctenka u on u.idzakaznik = z.idzakaznik left join adresa a on z.idadresa = a.idadresa
where u.iductenka is null group by a.mesto order by pocetzakaznikubeznakupu desc;

select a.mesto, count(z.idzakaznik) pocet from zakaznik z left join uctenka u on u.idzakaznik = z.idzakaznik inner join adresa a on a.idadresa = z.idadresa 
where u.iductenka is null group by a.mesto order by pocet desc;
